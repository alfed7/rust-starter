# Development settings, loaded when APP_ENV is unset or `development`.
# Copy to .env.development.

# Network address on which the HTTP server listens.
BIND_ADDR=127.0.0.1:3000

# Log filter; `debug` is useful locally.
RUST_LOG=debug

# Set to `true` only when the API is intentionally public to browser clients.
ALLOW_ANY_ORIGIN=false
