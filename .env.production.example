# Production settings, loaded when APP_ENV=production.
# Copy to .env.production in the service's working directory.

# Network address on which the HTTP server listens. Use 0.0.0.0:<port> inside
# a container; 127.0.0.1 is unreachable from outside it.
BIND_ADDR=127.0.0.1:3000

# Log filter, e.g. `info,rust_starter=debug`.
RUST_LOG=info

# Set to `true` only when the API is intentionally public to browser clients.
ALLOW_ANY_ORIGIN=false
